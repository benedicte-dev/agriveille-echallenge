# Copier en .env et renseigner. Ne jamais committer .env.
# PostgreSQL (dev : conteneur Docker agriveille-db sur 127.0.0.1:5440 ; prod : Neon)
DATABASE_URL=
# Jeton du cron Vercel (Authorization: Bearer ...) pour /api/cron/monitoring
CRON_SECRET=
# Secret applicatif (32 octets aléatoires, ex. openssl rand -base64 32)
SESSION_SECRET=
# API 229langues (traduction, TTS, STT) : côté serveur uniquement
LANGUES_API_BASE=
LANGUES_API_KEY=
LANGUES_HF_TOKEN=
LANGUES_PROJECT_ID=
