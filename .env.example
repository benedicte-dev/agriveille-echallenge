# Copier en .env et renseigner. Ne jamais committer .env.
# PostgreSQL (dev : conteneur Docker agriveille-db sur 127.0.0.1:5440 ; prod : Neon)
DATABASE_URL=
# Jeton du cron Vercel (Authorization: Bearer ...) pour /api/cron/monitoring — 32 caractères minimum
CRON_SECRET=
# API 229langues (traduction, TTS, STT) : côté serveur uniquement
LANGUES_API_BASE=https://ronaldodev-api.hf.space
LANGUES_API_KEY=
LANGUES_HF_TOKEN=
# URL publique (liens des QR codes de quittance), ex. https://agriveille.vercel.app
NEXT_PUBLIC_APP_URL=
# Affiche l'encadré « comptes de démonstration » sur /connexion (mettre false en production réelle)
NEXT_PUBLIC_DEMO_MODE=true
